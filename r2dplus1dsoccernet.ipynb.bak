      "source": [
        "# CELL — Evaluation on TEST split only\n",
        "\n",
        "import torch\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "from sklearn.metrics import (\n",
        "    confusion_matrix,\n",
        "    ConfusionMatrixDisplay,\n",
        "    precision_recall_fscore_support,\n",
        "    precision_recall_curve,\n",
        "    average_precision_score,\n",
        "    roc_curve,\n",
        "    auc,\n",
        ")\n",
        "\n",
        "device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
        "model.to(device)\n",
        "model.eval()\n",
        "\n",
        "goal_id = label2id[\"goal\"]\n",
        "\n",
        "y_true = []\n",
        "y_pred = []\n",
        "y_score = []   # P(goal)\n",
        "\n",
        "with torch.no_grad():\n",
        "    for x, y in test_loader:\n",
        "        x = x.to(device, non_blocking=True)\n",
        "\n",
        "        logits = model(x)\n",
        "        probs = torch.softmax(logits, dim=1)\n",
        "        p_goal = probs[:, goal_id].detach().cpu().numpy()\n",
        "\n",
        "        preds = logits.argmax(dim=1).detach().cpu().numpy()\n",
        "\n",
        "        y_score.extend(p_goal)\n",
        "        y_pred.extend(preds)\n",
        "        y_true.extend(y.numpy())\n",
        "\n",
        "y_true = np.array(y_true)\n",
        "y_pred = np.array(y_pred)\n",
        "y_score = np.array(y_score)\n",
        "\n",
        "# -------------------------\n",
        "# Detect labeled vs unlabeled test\n",
        "# -------------------------\n",
        "is_labeled = np.any(y_true >= 0)\n",
        "\n",
        "print(\"Test samples:\", len(y_score))\n",
        "print(\"Labeled test:\", is_labeled)\n",
        "\n",
        "# =========================\n",
        "# Metrics (ONLY if labeled)\n",
        "# =========================\n",
        "if is_labeled:\n",
        "    y_true_bin = (y_true == goal_id).astype(int)\n",
        "    y_pred_bin = (y_pred == goal_id).astype(int)\n",
        "\n",
        "    prec, rec, f1, _ = precision_recall_fscore_support(\n",
        "        y_true_bin, y_pred_bin, average=\"binary\", zero_division=0\n",
        "    )\n",
        "\n",
        "    print(\"\\nTEST metrics (goal vs background):\")\n",
        "    print(f\"  Precision: {prec:.4f}\")\n",
        "    print(f\"  Recall   : {rec:.4f}\")\n",
        "    print(f\"  F1-score : {f1:.4f}\")\n",
        "\n",
        "    # Confusion matrix\n",
        "    cm = confusion_matrix(y_true_bin, y_pred_bin)\n",
        "    fig, ax = plt.subplots(figsize=(5, 5))\n",
        "    ConfusionMatrixDisplay(cm, display_labels=[\"background\", \"goal\"]).plot(\n",
        "        ax=ax, cmap=\"Blues\", values_format=\"d\", colorbar=False\n",
        "    )\n",
        "    ax.set_title(\"Confusion Matrix (TEST)\")\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "\n",
        "    # Precision–Recall curve\n",
        "    p, r, _ = precision_recall_curve(y_true_bin, y_score)\n",
        "    ap = average_precision_score(y_true_bin, y_score)\n",
        "\n",
        "    fig, ax = plt.subplots(figsize=(6, 5))\n",
        "    ax.plot(r, p)\n",
        "    ax.set_title(f\"Precision–Recall (TEST)  AP={ap:.4f}\")\n",
        "    ax.set_xlabel(\"Recall\")\n",
        "    ax.set_ylabel(\"Precision\")\n",
        "    ax.set_xlim(0, 1)\n",
        "    ax.set_ylim(0, 1)\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "\n",
        "    # ROC curve\n",
        "    fpr, tpr, _ = roc_curve(y_true_bin, y_score)\n",
        "    roc_auc = auc(fpr, tpr)\n",
        "\n",
        "    fig, ax = plt.subplots(figsize=(6, 5))\n",
        "    ax.plot(fpr, tpr)\n",
        "    ax.plot([0, 1], [0, 1], linestyle=\"--\")\n",
        "    ax.set_title(f\"ROC (TEST)  AUC={roc_auc:.4f}\")\n",
        "    ax.set_xlabel(\"FPR\")\n",
        "    ax.set_ylabel(\"TPR\")\n",
        "    ax.set_xlim(0, 1)\n",
        "    ax.set_ylim(0, 1)\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "\n",
        "# =========================\n",
        "# Always-valid plots\n",
        "# =========================\n",
        "\n",
        "# Probability histogram (works even if unlabeled)\n",
        "fig, ax = plt.subplots(figsize=(7, 4))\n",
        "ax.hist(y_score, bins=40, alpha=0.8)\n",
        "ax.set_title(\"Predicted P(goal) Distribution (TEST)\")\n",
        "ax.set_xlabel(\"P(goal)\")\n",
        "ax.set_ylabel(\"Count\")\n",
        "plt.tight_layout()\n",
        "plt.show()\n"
      ]
    },
