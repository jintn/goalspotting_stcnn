      "source": [
        "import torch\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "from sklearn.metrics import (\n",
        "    precision_recall_fscore_support,\n",
        "    confusion_matrix,\n",
        "    ConfusionMatrixDisplay,\n",
        "    precision_recall_curve,\n",
        "    average_precision_score,\n",
        "    roc_curve,\n",
        "    auc,\n",
        ")\n",
        "\n",
        "device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
        "\n",
        "# ---- Load BEST checkpoint ----\n",
        "BEST = f\"{CKPT_DIR}/best.pt\"\n",
        "ckpt = torch.load(BEST, map_location=device)\n",
        "model.load_state_dict(ckpt[\"model\"])\n",
        "model.to(device)\n",
        "model.eval()\n",
        "\n",
        "# ---- Identify goal class index ----\n",
        "assert \"goal\" in label2id, \"Label 'goal' not found in label2id\"\n",
        "goal_id = label2id[\"goal\"]\n",
        "\n",
        "# ---- Collect labels, hard preds, and goal probabilities ----\n",
        "y_true = []\n",
        "y_pred = []\n",
        "y_score = []  # P(goal)\n",
        "\n",
        "with torch.no_grad():\n",
        "    for x, y in val_loader:\n",
        "        x = x.to(device, non_blocking=True)\n",
        "        logits = model(x)  # [B, C]\n",
        "\n",
        "        probs = torch.softmax(logits, dim=1)         # [B, C]\n",
        "        goal_prob = probs[:, goal_id].cpu().numpy()  # [B]\n",
        "\n",
        "        preds = logits.argmax(dim=1).cpu().numpy()\n",
        "\n",
        "        y_true.extend(y.numpy())\n",
        "        y_pred.extend(preds)\n",
        "        y_score.extend(goal_prob)\n",
        "\n",
        "y_true = np.array(y_true)\n",
        "y_pred = np.array(y_pred)\n",
        "y_score = np.array(y_score)\n",
        "\n",
        "# ---- Binary: goal vs not-goal ----\n",
        "y_true_bin = (y_true == goal_id).astype(int)\n",
        "y_pred_bin = (y_pred == goal_id).astype(int)\n",
        "\n",
        "prec, rec, f1, _ = precision_recall_fscore_support(\n",
        "    y_true_bin, y_pred_bin, average=\"binary\", zero_division=0\n",
        ")\n",
        "cm = confusion_matrix(y_true_bin, y_pred_bin)\n",
        "\n",
        "print(\"Goal metrics (validation):\")\n",
        "print(f\"  Precision: {prec:.4f}\")\n",
        "print(f\"  Recall   : {rec:.4f}\")\n",
        "print(f\"  F1-score : {f1:.4f}\")\n",
        "\n",
        "# =========================\n",
        "#          CHARTS\n",
        "# =========================\n",
        "\n",
        "# 1) Confusion matrix heatmap\n",
        "fig, ax = plt.subplots(figsize=(5, 5))\n",
        "disp = ConfusionMatrixDisplay(confusion_matrix=cm, display_labels=[\"background\", \"goal\"])\n",
        "disp.plot(ax=ax, values_format=\"d\", cmap=\"Blues\", colorbar=False)\n",
        "ax.set_title(\"Confusion Matrix (Goal vs Background)\")\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# 2) Score distributions (P(goal)) for each true class\n",
        "fig, ax = plt.subplots(figsize=(7, 4))\n",
        "ax.hist(y_score[y_true_bin == 0], bins=40, alpha=0.6, label=\"True background\")\n",
        "ax.hist(y_score[y_true_bin == 1], bins=40, alpha=0.6, label=\"True goal\")\n",
        "ax.set_title(\"Predicted Probability for Goal (Validation)\")\n",
        "ax.set_xlabel(\"P(goal)\")\n",
        "ax.set_ylabel(\"Count\")\n",
        "ax.legend()\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# 3) Precision–Recall curve (+ Average Precision)\n",
        "pr_prec, pr_rec, pr_thresh = precision_recall_curve(y_true_bin, y_score)\n",
        "ap = average_precision_score(y_true_bin, y_score)\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(6, 5))\n",
        "ax.plot(pr_rec, pr_prec)\n",
        "ax.set_title(f\"Precision–Recall Curve (AP={ap:.4f})\")\n",
        "ax.set_xlabel(\"Recall\")\n",
        "ax.set_ylabel(\"Precision\")\n",
        "ax.set_xlim(0, 1)\n",
        "ax.set_ylim(0, 1)\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# 4) ROC curve (+ AUC) (optional but handy)\n",
        "fpr, tpr, _ = roc_curve(y_true_bin, y_score)\n",
        "roc_auc = auc(fpr, tpr)\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(6, 5))\n",
        "ax.plot(fpr, tpr)\n",
        "ax.plot([0, 1], [0, 1], linestyle=\"--\")\n",
        "ax.set_title(f\"ROC Curve (AUC={roc_auc:.4f})\")\n",
        "ax.set_xlabel(\"False Positive Rate\")\n",
        "ax.set_ylabel(\"True Positive Rate\")\n",
        "ax.set_xlim(0, 1)\n",
        "ax.set_ylim(0, 1)\n",
        "plt.tight_layout()\n",
        "plt.show()\n"
      ]
    },
