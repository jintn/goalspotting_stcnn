      "source": [
        "\n",
        "import os, glob, json, random\n",
        "import pandas as pd\n",
        "import cv2\n",
        "from SoccerNet.utils import getListGames\n",
        "\n",
        "MANIFEST_PATH = f\"{MFST_DIR}/manifest_goal_vs_bg.csv\"\n",
        "\n",
        "# -------------------------\n",
        "# Config\n",
        "# -------------------------\n",
        "NEG_PER_POS = 3     # negatives per goal (start with 3–10)\n",
        "MIN_GAP_SEC = 10.0   # negatives must be at least this many seconds away from ANY event time\n",
        "CLIP_SEC = 4.0       # used to avoid sampling too close to edges\n",
        "SEED = 42\n",
        "random.seed(SEED)\n",
        "\n",
        "# -------------------------\n",
        "# Split lookup (source of truth)\n",
        "# -------------------------\n",
        "SPLITS = {\n",
        "    \"train\": set(getListGames(\"train\")),\n",
        "    \"valid\": set(getListGames(\"valid\")),\n",
        "    \"test\":  set(getListGames(\"test\")),\n",
        "}\n",
        "def get_split(rel_game):\n",
        "    for s, games in SPLITS.items():\n",
        "        if rel_game in games:\n",
        "            return s\n",
        "    return \"unknown\"\n",
        "\n",
        "# -------------------------\n",
        "# Helpers\n",
        "# -------------------------\n",
        "def find_jsons(root):\n",
        "    return glob.glob(os.path.join(root, \"**\", \"*.json\"), recursive=True)\n",
        "\n",
        "def safe_get_event_list(obj):\n",
        "    if isinstance(obj, dict):\n",
        "        for k in [\"annotations\", \"Annotations\", \"Actions\", \"events\", \"Labels\"]:\n",
        "            if k in obj and isinstance(obj[k], list):\n",
        "                return obj[k]\n",
        "    return []\n",
        "\n",
        "def event_label(ev):\n",
        "    for k in [\"label\", \"event\", \"type\", \"action\", \"class\"]:\n",
        "        if k in ev and isinstance(ev[k], str):\n",
        "            return ev[k]\n",
        "    if \"event\" in ev and isinstance(ev[\"event\"], dict) and isinstance(ev[\"event\"].get(\"label\"), str):\n",
        "        return ev[\"event\"][\"label\"]\n",
        "    return None\n",
        "\n",
        "def parse_game_time(game_time: str):\n",
        "    # \"1 - 12:34\"\n",
        "    if not isinstance(game_time, str) or \"-\" not in game_time:\n",
        "        return None, None\n",
        "    half_str, mmss = game_time.split(\"-\", 1)\n",
        "    half_str, mmss = half_str.strip(), mmss.strip()\n",
        "    try:\n",
        "        half = int(half_str)\n",
        "        mm, ss = mmss.split(\":\")\n",
        "        tsec = int(mm) * 60 + int(ss)\n",
        "        return half, float(tsec)\n",
        "    except Exception:\n",
        "        return None, None\n",
        "\n",
        "def video_duration_sec(video_path: str):\n",
        "    cap = cv2.VideoCapture(video_path)\n",
        "    if not cap.isOpened():\n",
        "        return None\n",
        "    fps = cap.get(cv2.CAP_PROP_FPS) or 25.0\n",
        "    n = cap.get(cv2.CAP_PROP_FRAME_COUNT) or 0\n",
        "    cap.release()\n",
        "    if n <= 1:\n",
        "        return None\n",
        "    return float(n / fps)\n",
        "\n",
        "def sample_background_times(duration, forbidden_times, n_samples, min_gap=10.0):\n",
        "    \"\"\"\n",
        "    duration: seconds in this half-video\n",
        "    forbidden_times: list of event times (seconds) in this half\n",
        "    returns list of sampled background center_sec\n",
        "    \"\"\"\n",
        "    if duration is None or duration <= (CLIP_SEC + 1):\n",
        "        return []\n",
        "    lo = CLIP_SEC/2\n",
        "    hi = duration - CLIP_SEC/2\n",
        "    if hi <= lo:\n",
        "        return []\n",
        "\n",
        "    out = []\n",
        "    tries = 0\n",
        "    max_tries = 5000\n",
        "\n",
        "    forbidden_times = list(forbidden_times)\n",
        "\n",
        "    while len(out) < n_samples and tries < max_tries:\n",
        "        tries += 1\n",
        "        t = random.uniform(lo, hi)\n",
        "        # far from any event\n",
        "        if all(abs(t - e) >= min_gap for e in forbidden_times):\n",
        "            out.append(t)\n",
        "            forbidden_times.append(t)  # keep negatives spread out too (optional)\n",
        "    return out\n",
        "\n",
        "# -------------------------\n",
        "# Find root\n",
        "# -------------------------\n",
        "possible_roots = [os.path.join(DATA_DIR, \"dataset\"), DATA_DIR]\n",
        "root = next((p for p in possible_roots if os.path.isdir(p)), None)\n",
        "print(\"Using root:\", root)\n",
        "\n",
        "if os.path.exists(MANIFEST_PATH):\n",
        "    print(\"Manifest already exists:\", MANIFEST_PATH)\n",
        "else:\n",
        "    rows = []\n",
        "    jsons = find_jsons(root) if root else []\n",
        "    print(\"Found JSON files:\", len(jsons))\n",
        "\n",
        "    for jp in jsons:\n",
        "        match_dir = os.path.dirname(jp)\n",
        "\n",
        "        v1 = os.path.join(match_dir, \"1_224p.mkv\")\n",
        "        v2 = os.path.join(match_dir, \"2_224p.mkv\")\n",
        "        if not (os.path.exists(v1) and os.path.exists(v2)):\n",
        "            continue\n",
        "\n",
        "        rel_game = os.path.relpath(match_dir, start=DATA_DIR)\n",
        "        split = get_split(rel_game)\n",
        "        if split == \"unknown\":\n",
        "            continue\n",
        "\n",
        "        try:\n",
        "            with open(jp, \"r\") as f:\n",
        "                obj = json.load(f)\n",
        "        except Exception:\n",
        "            continue\n",
        "\n",
        "        events = safe_get_event_list(obj)\n",
        "        if not events:\n",
        "            continue\n",
        "\n",
        "        # Collect all event times per half (for \"stay away from any event\" negatives)\n",
        "        all_times = {1: [], 2: []}\n",
        "        goal_times = {1: [], 2: []}\n",
        "        son_times = {1: [], 2: []}\n",
        "        soff_times = {1: [], 2: []}\n",
        "\n",
        "        for ev in events:\n",
        "            raw = event_label(ev)\n",
        "            if raw is None:\n",
        "                continue\n",
        "            half, tsec = parse_game_time(ev.get(\"gameTime\", \"\"))\n",
        "            if half not in (1, 2) or tsec is None:\n",
        "                continue\n",
        "\n",
        "            all_times[half].append(tsec)\n",
        "\n",
        "            if raw.strip().lower() == \"goal\":\n",
        "                goal_times[half].append(tsec)\n",
        "            \n",
        "            if raw.strip().lower() == \"shots on target\":\n",
        "                son_times[half].append(tsec)\n",
        "\n",
        "            if raw.strip().lower() == \"shots off target\":\n",
        "                soff_times[half].append(tsec)\n",
        "\n",
        "        # Add goal positives + background negatives per half\n",
        "        for half in (1, 2):\n",
        "            video_path = v1 if half == 1 else v2\n",
        "            dur = video_duration_sec(video_path)\n",
        "            if dur is None:\n",
        "                continue\n",
        "\n",
        "            # positives\n",
        "            for tsec in goal_times[half]:\n",
        "                rows.append({\n",
        "                    \"split\": split,\n",
        "                    \"rel_game\": rel_game,\n",
        "                    \"video_path\": video_path,\n",
        "                    \"half\": half,\n",
        "                    \"center_sec\": float(tsec),\n",
        "                    \"label\": \"goal\"\n",
        "                })\n",
        "            \n",
        "            # positives\n",
        "            for tsec in son_times[half]:\n",
        "                rows.append({\n",
        "                    \"split\": split,\n",
        "                    \"rel_game\": rel_game,\n",
        "                    \"video_path\": video_path,\n",
        "                    \"half\": half,\n",
        "                    \"center_sec\": float(tsec),\n",
        "                    \"label\": \"son\"\n",
        "                })\n",
        "\n",
        "            for tsec in soff_times[half]:\n",
        "                rows.append({\n",
        "                    \"split\": split,\n",
        "                    \"rel_game\": rel_game,\n",
        "                    \"video_path\": video_path,\n",
        "                    \"half\": half,\n",
        "                    \"center_sec\": float(tsec),\n",
        "                    \"label\": \"soff\"\n",
        "                })\n",
        "\n",
        "            # negatives: NEG_PER_POS per positive in this half\n",
        "            n_neg = NEG_PER_POS * len(goal_times[half])\n",
        "            if n_neg > 0:\n",
        "                neg_times = sample_background_times(\n",
        "                    duration=dur,\n",
        "                    forbidden_times=all_times[half],\n",
        "                    n_samples=n_neg,\n",
        "                    min_gap=MIN_GAP_SEC\n",
        "                )\n",
        "                for t in neg_times:\n",
        "                    rows.append({\n",
        "                        \"split\": split,\n",
        "                        \"rel_game\": rel_game,\n",
        "                        \"video_path\": video_path,\n",
        "                        \"half\": half,\n",
        "                        \"center_sec\": float(t),\n",
        "                        \"label\": \"background\"\n",
        "                    })\n",
        "\n",
        "    df = pd.DataFrame(rows).drop_duplicates()\n",
        "    print(\"Rows:\", len(df))\n",
        "    if len(df) == 0:\n",
        "        raise RuntimeError(\"Manifest is empty. Check DATA_DIR/JSON structure or whether goal labels exist.\")\n",
        "\n",
        "    print(\"\\nLabel counts:\\n\", df[\"label\"].value_counts())\n",
        "    print(\"\\nSplit counts:\\n\", df[\"split\"].value_counts())\n",
        "\n",
        "    df.to_csv(MANIFEST_PATH, index=False)\n",
        "    print(\"Wrote:\", MANIFEST_PATH)\n",
        "    display(df.head())\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 13,
      "metadata": {
