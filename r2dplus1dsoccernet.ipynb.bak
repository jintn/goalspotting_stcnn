      "source": [
        "# CELL — Multi-game sliding-window goal spotting + classification-style reporting\n",
        "\n",
        "import cv2\n",
        "import numpy as np\n",
        "import torch\n",
        "import matplotlib.pyplot as plt\n",
        "import pandas as pd\n",
        "import random\n",
        "from collections import deque\n",
        "\n",
        "device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
        "model.to(device).eval()\n",
        "torch.backends.cudnn.benchmark = True\n",
        "\n",
        "assert \"goal\" in label2id, \"Label 'goal' not in label2id\"\n",
        "goal_id = label2id[\"goal\"]\n",
        "\n",
        "assert \"df_valid\" in globals(), \"df_valid not found. Make sure you've created df_valid from your manifest.\"\n",
        "assert \"video_path\" in df_valid.columns, \"df_valid must contain a 'video_path' column.\"\n",
        "\n",
        "# -------------------------\n",
        "# Config (tweak these)\n",
        "# -------------------------\n",
        "SEED = 42\n",
        "random.seed(SEED)\n",
        "np.random.seed(SEED)\n",
        "\n",
        "NUM_HALVES_TO_SCAN = 2           # how many validation halves to scan\n",
        "MAX_SECONDS_PER_HALF = None        # None = full half (can be slow), or e.g. 1200 for first 20 min\n",
        "THRESHOLD = 0.92\n",
        "CLIP_SEC = 4.0\n",
        "STRIDE_SEC = 1.0\n",
        "NUM_FRAMES = 16\n",
        "SIZE = 112\n",
        "BATCH_SIZE = 64\n",
        "\n",
        "# evaluation tolerances\n",
        "MATCH_TOL_SEC = 5.0               # for timestamp-level TP/FP/FN matching\n",
        "NMS_SEP_SEC = 60.0                # for predicted timestamps after NMS\n",
        "\n",
        "# -------------------------\n",
        "# Helpers: video i/o\n",
        "# -------------------------\n",
        "def video_duration_fps(video_path: str):\n",
        "    cap = cv2.VideoCapture(video_path)\n",
        "    if not cap.isOpened():\n",
        "        raise RuntimeError(f\"Could not open video: {video_path}\")\n",
        "    fps = cap.get(cv2.CAP_PROP_FPS) or 25.0\n",
        "    n = cap.get(cv2.CAP_PROP_FRAME_COUNT) or 0\n",
        "    cap.release()\n",
        "    if n <= 1:\n",
        "        raise RuntimeError(f\"Could not read frame count for: {video_path}\")\n",
        "    return float(n / fps), float(fps)\n",
        "\n",
        "def extract_clip_cv2(video_path, center_sec, clip_sec=4.0, num_frames=16, size=112):\n",
        "    cap = cv2.VideoCapture(video_path)\n",
        "    if not cap.isOpened():\n",
        "        raise RuntimeError(f\"Could not open video: {video_path}\")\n",
        "\n",
        "    fps = cap.get(cv2.CAP_PROP_FPS) or 25.0\n",
        "    start_sec = max(0.0, float(center_sec) - clip_sec / 2)\n",
        "    start_frame = int(start_sec * fps)\n",
        "\n",
        "    frames = []\n",
        "    step = int(max(1, (clip_sec * fps) / num_frames))\n",
        "\n",
        "    for i in range(num_frames):\n",
        "        cap.set(cv2.CAP_PROP_POS_FRAMES, start_frame + i * step)\n",
        "        ok, frame = cap.read()\n",
        "        if not ok:\n",
        "            break\n",
        "        frame = cv2.resize(frame, (size, size), interpolation=cv2.INTER_AREA)\n",
        "        frame = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)\n",
        "        frames.append(frame)\n",
        "\n",
        "    cap.release()\n",
        "\n",
        "    if len(frames) == 0:\n",
        "        raise RuntimeError(f\"No frames read from: {video_path}\")\n",
        "\n",
        "    while len(frames) < num_frames:\n",
        "        frames.append(frames[-1].copy())\n",
        "\n",
        "    arr = np.stack(frames, axis=0).astype(np.float32) / 255.0  # (T,H,W,C)\n",
        "    arr = np.transpose(arr, (3, 0, 1, 2))                      # (C,T,H,W)\n",
        "    return torch.from_numpy(arr)\n",
        "\n",
        "def nms_1d(times, scores, min_separation_sec=8.0):\n",
        "    \"\"\"Greedy NMS on 1D timestamps: keep highest score, suppress within +/- min_separation_sec/2.\"\"\"\n",
        "    if len(times) == 0:\n",
        "        return np.array([]), np.array([])\n",
        "    order = np.argsort(scores)[::-1]\n",
        "    keep = []\n",
        "    suppressed = np.zeros(len(times), dtype=bool)\n",
        "    half = min_separation_sec / 2.0\n",
        "\n",
        "    for i in order:\n",
        "        if suppressed[i]:\n",
        "            continue\n",
        "        keep.append(i)\n",
        "        close = np.abs(times - times[i]) <= half\n",
        "        suppressed |= close\n",
        "        suppressed[i] = False\n",
        "\n",
        "    keep = np.array(keep, dtype=int)\n",
        "    korder = np.argsort(times[keep])\n",
        "    return times[keep][korder], scores[keep][korder]\n",
        "\n",
        "def local_maxima_1d(times, scores):\n",
        "    if len(scores) < 3:\n",
        "        return times, scores\n",
        "    keep = [i for i in range(1, len(scores)-1)\n",
        "            if scores[i] >= scores[i-1] and scores[i] >= scores[i+1]]\n",
        "    return times[keep], scores[keep]\n",
        "\n",
        "\n",
        "# -------------------------\n",
        "# Helpers: parse GT goals from df_valid robustly\n",
        "# -------------------------\n",
        "def _find_first_col(df, candidates):\n",
        "    for c in candidates:\n",
        "        if c in df.columns:\n",
        "            return c\n",
        "    return None\n",
        "\n",
        "# common column guesses\n",
        "LABEL_COL = _find_first_col(df_valid, [\"label\", \"event\", \"action\", \"class\", \"label_name\", \"category\"])\n",
        "START_COL = _find_first_col(df_valid, [\"start_time\", \"start_sec\", \"t_start\", \"start\", \"time_start\"])\n",
        "END_COL   = _find_first_col(df_valid, [\"end_time\", \"end_sec\", \"t_end\", \"end\", \"time_end\"])\n",
        "TIME_COL  = _find_first_col(df_valid, [\"timestamp\", \"time\", \"t\", \"sec\", \"time_sec\"])\n",
        "\n",
        "if LABEL_COL is None:\n",
        "    raise RuntimeError(\n",
        "        \"Could not find a label column in df_valid. \"\n",
        "        \"Expected one of: label/event/action/class/label_name/category.\"\n",
        "    )\n",
        "\n",
        "LABEL_COL = \"label\"\n",
        "TIME_COL  = \"center_sec\"\n",
        "\n",
        "\n",
        "def get_gt_goal_intervals_for_video(video_path: str):\n",
        "    \"\"\"\n",
        "    Manifest uses point events at `center_sec`.\n",
        "    Return Nx2 intervals [t, t] for overlap logic.\n",
        "    \"\"\"\n",
        "    sub = df_valid[df_valid[\"video_path\"] == video_path].copy()\n",
        "    sub = sub[sub[LABEL_COL].astype(str).str.lower() == \"goal\"]\n",
        "\n",
        "    if len(sub) == 0:\n",
        "        return np.zeros((0, 2), dtype=np.float32)\n",
        "\n",
        "    t = pd.to_numeric(sub[TIME_COL], errors=\"coerce\").to_numpy(dtype=np.float32)\n",
        "    t = t[np.isfinite(t)]\n",
        "    if len(t) == 0:\n",
        "        return np.zeros((0, 2), dtype=np.float32)\n",
        "\n",
        "    # point-intervals\n",
        "    return np.stack([t, t], axis=1).astype(np.float32)\n",
        "\n",
        "# -------------------------\n",
        "# Sliding window inference\n",
        "# -------------------------\n",
        "\n",
        "def spot_goals_sliding_window_batched(\n",
        "    video_path,\n",
        "    clip_sec=4.0,\n",
        "    stride_sec=1.0,\n",
        "    num_frames=16,\n",
        "    size=112,\n",
        "    threshold=0.998,\n",
        "    nms_sep_sec=20.0,\n",
        "    max_seconds=None,\n",
        "    batch_size=64,\n",
        "    use_amp=True,\n",
        "):\n",
        "    cap = cv2.VideoCapture(video_path)\n",
        "    if not cap.isOpened():\n",
        "        raise RuntimeError(f\"Could not open video: {video_path}\")\n",
        "\n",
        "    fps = cap.get(cv2.CAP_PROP_FPS) or 25.0\n",
        "    total_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT) or 0)\n",
        "\n",
        "    # scan limit\n",
        "    if max_seconds is None:\n",
        "        end_frame_scan = total_frames - 1\n",
        "    else:\n",
        "        end_frame_scan = min(total_frames - 1, int(float(max_seconds) * fps))\n",
        "\n",
        "    clip_frames = int(round(clip_sec * fps))              # e.g., 4s * 25fps = 100\n",
        "    half = clip_frames // 2\n",
        "    stride_frames = max(1, int(round(stride_sec * fps)))  # e.g., 1s * 25fps = 25\n",
        "\n",
        "    first_center = half\n",
        "    last_center = end_frame_scan - half\n",
        "    if last_center <= first_center:\n",
        "        cap.release()\n",
        "        raise RuntimeError(\"Video too short for chosen clip_sec/max_seconds.\")\n",
        "\n",
        "    center_frames = np.arange(first_center, last_center + 1, stride_frames, dtype=int)\n",
        "    centers = center_frames.astype(np.float32) / float(fps)  # seconds, like before\n",
        "\n",
        "    probs = np.full(len(center_frames), np.nan, dtype=np.float32)\n",
        "\n",
        "    buffer_maxlen = clip_frames + stride_frames + 10\n",
        "    buf = deque(maxlen=buffer_maxlen)  # (frame_idx, frame_rgb_resized)\n",
        "\n",
        "    next_center_i = 0\n",
        "    current_frame_idx = -1\n",
        "\n",
        "    batch_clips = []\n",
        "    batch_out_indices = []\n",
        "\n",
        "    def build_clip_from_buffer(start_f, end_f):\n",
        "        frame_map = {fi: fr for fi, fr in buf}\n",
        "        idxs = np.linspace(start_f, end_f - 1, num_frames).round().astype(int)\n",
        "\n",
        "        frames = []\n",
        "        last = None\n",
        "        for fi in idxs:\n",
        "            fr = frame_map.get(fi, None)\n",
        "            if fr is None:\n",
        "                fr = last\n",
        "            if fr is None:\n",
        "                raise RuntimeError(\"Buffer miss. Increase buffer_maxlen.\")\n",
        "            frames.append(fr)\n",
        "            last = fr\n",
        "\n",
        "        arr = np.stack(frames, axis=0).astype(np.float32) / 255.0  # (T,H,W,C)\n",
        "        arr = np.transpose(arr, (3, 0, 1, 2))  # (C,T,H,W)\n",
        "        return torch.from_numpy(arr)\n",
        "\n",
        "    with torch.no_grad():\n",
        "        while current_frame_idx < end_frame_scan:\n",
        "            ok, frame = cap.read()\n",
        "            if not ok:\n",
        "                break\n",
        "            current_frame_idx += 1\n",
        "\n",
        "            # preprocess once per decoded frame\n",
        "            frame = cv2.resize(frame, (size, size), interpolation=cv2.INTER_AREA)\n",
        "            frame = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)\n",
        "            buf.append((current_frame_idx, frame))\n",
        "\n",
        "            # process centers whose window is now fully available\n",
        "            while next_center_i < len(center_frames):\n",
        "                cf = center_frames[next_center_i]\n",
        "                start_f = cf - half\n",
        "                end_f = cf + half\n",
        "\n",
        "                if current_frame_idx < (end_f - 1):\n",
        "                    break\n",
        "\n",
        "                clip = build_clip_from_buffer(start_f, end_f)\n",
        "                batch_clips.append(clip)\n",
        "                batch_out_indices.append(next_center_i)\n",
        "                next_center_i += 1\n",
        "\n",
        "                if len(batch_clips) >= batch_size:\n",
        "                    x = torch.stack(batch_clips, dim=0).to(device)  # [B,C,T,H,W]\n",
        "                    if device == \"cuda\":\n",
        "                        with torch.amp.autocast(\"cuda\", enabled=use_amp):\n",
        "\n",
        "                            logits = model(x)\n",
        "                            p = torch.softmax(logits, dim=1)[:, goal_id]\n",
        "                    else:\n",
        "                        logits = model(x)\n",
        "                        p = torch.softmax(logits, dim=1)[:, goal_id]\n",
        "\n",
        "                    probs[np.array(batch_out_indices, dtype=int)] = p.detach().float().cpu().numpy()\n",
        "                    batch_clips.clear()\n",
        "                    batch_out_indices.clear()\n",
        "\n",
        "        # flush leftovers\n",
        "        if len(batch_clips) > 0:\n",
        "            x = torch.stack(batch_clips, dim=0).to(device)\n",
        "            if device == \"cuda\":\n",
        "                with torch.amp.autocast(\"cuda\", enabled=use_amp):\n",
        "                    logits = model(x)\n",
        "                    p = torch.softmax(logits, dim=1)[:, goal_id]\n",
        "            else:\n",
        "                logits = model(x)\n",
        "                p = torch.softmax(logits, dim=1)[:, goal_id]\n",
        "            probs[np.array(batch_out_indices, dtype=int)] = p.detach().float().cpu().numpy()\n",
        "\n",
        "    cap.release()\n",
        "    \n",
        "    valid = np.isfinite(probs)\n",
        "    centers = centers[valid]\n",
        "    probs = probs[valid]\n",
        "    if np.nanmax(probs) > 1.0 or np.nanmin(probs) < 0.0:\n",
        "        raise RuntimeError(\"p_goal outside [0,1] — probs not fully filled or softmax not applied.\")\n",
        "\n",
        "    det_mask = probs >= threshold\n",
        "    det_times = centers[det_mask]\n",
        "    det_scores = probs[det_mask]\n",
        "    det_times, det_scores = local_maxima_1d(det_times, det_scores)\n",
        "\n",
        "    final_times, final_scores = nms_1d(det_times, det_scores, min_separation_sec=nms_sep_sec)\n",
        "    print(\"filled:\", np.isfinite(probs).sum(), \"/\", len(probs), \"next_center_i:\", next_center_i)\n",
        "    return centers, probs, final_times, final_scores\n",
        "\n",
        "# -------------------------\n",
        "# Evaluation utilities\n",
        "# -------------------------\n",
        "def intervals_overlap(a_start, a_end, b_start, b_end):\n",
        "    return (a_start <= b_end) and (b_start <= a_end)\n",
        "\n",
        "def make_window_labels(centers, gt_intervals, clip_sec):\n",
        "    \"\"\"\n",
        "    Window-level label: 1 if the window [c-clip/2, c+clip/2] overlaps any GT interval.\n",
        "    \"\"\"\n",
        "    if len(gt_intervals) == 0:\n",
        "        return np.zeros(len(centers), dtype=np.int64)\n",
        "    half = clip_sec / 2.0\n",
        "    y = np.zeros(len(centers), dtype=np.int64)\n",
        "    for i, c in enumerate(centers):\n",
        "        ws, we = c - half, c + half\n",
        "        # overlap with any gt interval\n",
        "        for (gs, ge) in gt_intervals:\n",
        "            if intervals_overlap(ws, we, gs, ge):\n",
        "                y[i] = 1\n",
        "                break\n",
        "    return y\n",
        "\n",
        "def match_timestamps(pred_times, gt_times, tol_sec=5.0):\n",
        "    \"\"\"\n",
        "    Timestamp-level matching with tolerance.\n",
        "    Returns TP, FP, FN and matched indices.\n",
        "    \"\"\"\n",
        "    pred_times = np.asarray(pred_times, dtype=np.float32)\n",
        "    gt_times = np.asarray(gt_times, dtype=np.float32)\n",
        "\n",
        "    if len(pred_times) == 0 and len(gt_times) == 0:\n",
        "        return 0, 0, 0, [], []\n",
        "    if len(pred_times) == 0:\n",
        "        return 0, 0, len(gt_times), [], list(range(len(gt_times)))\n",
        "    if len(gt_times) == 0:\n",
        "        return 0, len(pred_times), 0, list(range(len(pred_times))), []\n",
        "\n",
        "    # greedy: for each pred (highest score is already baked into NMS output ordering by time, so just time order)\n",
        "    matched_gt = set()\n",
        "    tp = 0\n",
        "    fp = 0\n",
        "    pred_missed = []\n",
        "    for pi, pt in enumerate(pred_times):\n",
        "        # find closest unmatched gt within tol\n",
        "        d = np.abs(gt_times - pt)\n",
        "        candidates = [(gi, d[gi]) for gi in range(len(gt_times)) if gi not in matched_gt and d[gi] <= tol_sec]\n",
        "        if not candidates:\n",
        "            fp += 1\n",
        "            pred_missed.append(pi)\n",
        "        else:\n",
        "            gi = min(candidates, key=lambda x: x[1])[0]\n",
        "            matched_gt.add(gi)\n",
        "            tp += 1\n",
        "\n",
        "    fn = len(gt_times) - len(matched_gt)\n",
        "    gt_missed = [gi for gi in range(len(gt_times)) if gi not in matched_gt]\n",
        "    return tp, fp, fn, pred_missed, gt_missed\n",
        "\n",
        "def prf(tp, fp, fn):\n",
        "    p = tp / (tp + fp) if (tp + fp) > 0 else 0.0\n",
        "    r = tp / (tp + fn) if (tp + fn) > 0 else 0.0\n",
        "    f = (2*p*r/(p+r)) if (p+r) > 0 else 0.0\n",
        "    return p, r, f\n",
        "\n",
        "# -------------------------\n",
        "# Pick many halves across many games (if possible)\n",
        "# -------------------------\n",
        "valid_paths = df_valid[\"video_path\"].dropna().unique().tolist()\n",
        "valid_paths = [p for p in valid_paths if isinstance(p, str) and len(p) > 0]\n",
        "if len(valid_paths) == 0:\n",
        "    raise RuntimeError(\"No valid video paths found in df_valid.\")\n",
        "\n",
        "if \"rel_game\" in df_valid.columns:\n",
        "    # spread across games\n",
        "    games = df_valid[\"rel_game\"].dropna().unique().tolist()\n",
        "    random.shuffle(games)\n",
        "    chosen = []\n",
        "    for g in games:\n",
        "        sub = df_valid[df_valid[\"rel_game\"] == g]\n",
        "        paths = sub[\"video_path\"].dropna().unique().tolist()\n",
        "        paths = [p for p in paths if isinstance(p, str) and len(p) > 0]\n",
        "        if len(paths) == 0:\n",
        "            continue\n",
        "        chosen.append(random.choice(paths))\n",
        "        if len(chosen) >= NUM_HALVES_TO_SCAN:\n",
        "            break\n",
        "    if len(chosen) == 0:\n",
        "        chosen = random.sample(valid_paths, k=min(NUM_HALVES_TO_SCAN, len(valid_paths)))\n",
        "else:\n",
        "    chosen = random.sample(valid_paths, k=min(NUM_HALVES_TO_SCAN, len(valid_paths)))\n",
        "\n",
        "print(f\"Scanning {len(chosen)} validation halves (seed={SEED})\")\n",
        "if \"rel_game\" in df_valid.columns or \"half\" in df_valid.columns:\n",
        "    for vp in chosen[:min(5, len(chosen))]:\n",
        "        ex = df_valid[df_valid[\"video_path\"] == vp].iloc[0]\n",
        "        meta = {c: ex[c] for c in [\"rel_game\", \"half\"] if c in df_valid.columns}\n",
        "        print(\"  \", vp, meta)\n",
        "    if len(chosen) > 5:\n",
        "        print(\"  ...\")\n",
        "\n",
        "# -------------------------\n",
        "# Run: inference + reporting\n",
        "# -------------------------\n",
        "rows = []\n",
        "all_window_tp = all_window_fp = all_window_fn = 0\n",
        "all_ts_tp = all_ts_fp = all_ts_fn = 0\n",
        "\n",
        "for idx, VIDEO_PATH in enumerate(chosen, 1):\n",
        "    ex = df_valid[df_valid[\"video_path\"] == VIDEO_PATH].iloc[0]\n",
        "    meta = {c: ex[c] for c in [\"rel_game\", \"half\"] if c in df_valid.columns}\n",
        "\n",
        "    gt_intervals = get_gt_goal_intervals_for_video(VIDEO_PATH)\n",
        "    # reduce to \"representative\" GT timestamps for timestamp-level eval (midpoint of interval)\n",
        "    gt_times = gt_intervals.mean(axis=1) if len(gt_intervals) else np.array([], dtype=np.float32)\n",
        "    centers, p_goal, pred_times, pred_scores = spot_goals_sliding_window_batched(\n",
        "        VIDEO_PATH,\n",
        "        clip_sec=CLIP_SEC,\n",
        "        stride_sec=STRIDE_SEC,\n",
        "        num_frames=NUM_FRAMES,\n",
        "        size=SIZE,\n",
        "        threshold=THRESHOLD,\n",
        "        nms_sep_sec=NMS_SEP_SEC,\n",
        "        max_seconds=MAX_SECONDS_PER_HALF,\n",
        "        batch_size=BATCH_SIZE,\n",
        "        use_amp=True,\n",
        "    )\n",
        "    id2label = {v: k for k, v in label2id.items()}\n",
        "    # after you get centers and p_goal, do:\n",
        "    with torch.no_grad():\n",
        "        for t in pred_times:\n",
        "            clip = extract_clip_cv2(VIDEO_PATH, t, clip_sec=CLIP_SEC, num_frames=NUM_FRAMES, size=SIZE).unsqueeze(0).to(device)\n",
        "            logits = model(clip)\n",
        "            probs = torch.softmax(logits, dim=1)[0].detach().cpu().numpy()\n",
        "            top = int(probs.argmax())\n",
        "            print(f\"t={t:.1f}s  top_class={top} ({id2label.get(top,'?')})  top_p={probs[top]:.3f}  goal_p={probs[goal_id]:.3f}\")\n",
        "\n",
        "    # ---- DEBUG GT ROWS ----\n",
        "    sub = df_valid[df_valid[\"video_path\"] == VIDEO_PATH].copy()\n",
        "    print(\"\\nRaw rows for this video:\")\n",
        "    print(sub[[\"label\", \"center_sec\"]].head(20))\n",
        "\n",
        "    goals = sub[sub[\"label\"].astype(str).str.lower() == \"goal\"]\n",
        "    print(\"\\nGoal rows:\")\n",
        "    print(goals[[\"center_sec\"]].sort_values(\"center_sec\"))\n",
        "    print(\"----------------------------\")\n",
        "    # -------------------------\n",
        "    # DEBUG\n",
        "    print(\"\\nDEBUG for:\", VIDEO_PATH)\n",
        "    print(\"GT:\", np.sort(gt_times))\n",
        "    print(\"Pred:\", pred_times)\n",
        "    for pt in pred_times:\n",
        "        if len(gt_times):\n",
        "            d = np.min(np.abs(gt_times - pt))\n",
        "            print(\"pred\", pt, \"closest dist\", d)\n",
        "    print(\"-----------------------------------\")\n",
        "    # ---------------------------------\n",
        "\n",
        "    # window-level classification labels and metrics (at THRESHOLD)\n",
        "    y_true = make_window_labels(centers, gt_intervals, clip_sec=CLIP_SEC)\n",
        "    y_pred = (p_goal >= THRESHOLD).astype(np.int64)\n",
        "\n",
        "    w_tp = int(((y_true == 1) & (y_pred == 1)).sum())\n",
        "    w_fp = int(((y_true == 0) & (y_pred == 1)).sum())\n",
        "    w_fn = int(((y_true == 1) & (y_pred == 0)).sum())\n",
        "    w_p, w_r, w_f1 = prf(w_tp, w_fp, w_fn)\n",
        "\n",
        "    all_window_tp += w_tp\n",
        "    all_window_fp += w_fp\n",
        "    all_window_fn += w_fn\n",
        "\n",
        "    # timestamp-level spotting metrics\n",
        "    ts_tp, ts_fp, ts_fn, pred_missed, gt_missed = match_timestamps(pred_times, gt_times, tol_sec=MATCH_TOL_SEC)\n",
        "    ts_p, ts_r, ts_f1 = prf(ts_tp, ts_fp, ts_fn)\n",
        "\n",
        "    all_ts_tp += ts_tp\n",
        "    all_ts_fp += ts_fp\n",
        "    all_ts_fn += ts_fn\n",
        "\n",
        "    # print per-half summary\n",
        "    print(f\"\\n[{idx}/{len(chosen)}] {VIDEO_PATH}\")\n",
        "    if meta:\n",
        "        print(\"  Meta:\", meta)\n",
        "    print(f\"  Windows evaluated: {len(centers)}  |  threshold={THRESHOLD}\")\n",
        "    print(f\"  GT goals: {len(gt_times)}  |  Pred goals(after NMS): {len(pred_times)}  |  match_tol={MATCH_TOL_SEC}s\")\n",
        "    print(f\"  Timestamp-level: TP={ts_tp} FP={ts_fp} FN={ts_fn}  |  P={ts_p:.3f} R={ts_r:.3f} F1={ts_f1:.3f}\")\n",
        "    print(f\"  Window-level:     TP={w_tp} FP={w_fp} FN={w_fn}  |  P={w_p:.3f} R={w_r:.3f} F1={w_f1:.3f}\")\n",
        "\n",
        "    if len(pred_times) > 0:\n",
        "        print(\"  Top predicted timestamps:\")\n",
        "        for t, s in list(zip(pred_times, pred_scores))[:10]:\n",
        "            print(f\"    t={t:7.2f}s   P(goal)={s:.3f}\")\n",
        "\n",
        "    rows.append({\n",
        "        \"video_path\": VIDEO_PATH,\n",
        "        **meta,\n",
        "        \"n_windows\": len(centers),\n",
        "        \"gt_goals\": int(len(gt_times)),\n",
        "        \"pred_goals\": int(len(pred_times)),\n",
        "        \"ts_TP\": int(ts_tp), \"ts_FP\": int(ts_fp), \"ts_FN\": int(ts_fn),\n",
        "        \"ts_P\": float(ts_p), \"ts_R\": float(ts_r), \"ts_F1\": float(ts_f1),\n",
        "        \"win_TP\": int(w_tp), \"win_FP\": int(w_fp), \"win_FN\": int(w_fn),\n",
        "        \"win_P\": float(w_p), \"win_R\": float(w_r), \"win_F1\": float(w_f1),\n",
        "        \"mean_p_goal\": float(np.mean(p_goal)),\n",
        "        \"max_p_goal\": float(np.max(p_goal)),\n",
        "    })\n",
        "\n",
        "# -------------------------\n",
        "# Aggregate summary\n",
        "# -------------------------\n",
        "W_P, W_R, W_F1 = prf(all_window_tp, all_window_fp, all_window_fn)\n",
        "TS_P, TS_R, TS_F1 = prf(all_ts_tp, all_ts_fp, all_ts_fn)\n",
        "\n",
        "print(\"\\n====================\")\n",
        "print(\"OVERALL (across scanned halves)\")\n",
        "print(\"====================\")\n",
        "print(f\"Timestamp-level: TP={all_ts_tp} FP={all_ts_fp} FN={all_ts_fn}  |  P={TS_P:.3f} R={TS_R:.3f} F1={TS_F1:.3f}\")\n",
        "print(f\"Window-level:     TP={all_window_tp} FP={all_window_fp} FN={all_window_fn}  |  P={W_P:.3f} R={W_R:.3f} F1={W_F1:.3f}\")\n",
        "\n",
        "print(\"p_goal min/max:\", p_goal.min(), p_goal.max())\n",
        "print(\"unique-ish:\", np.unique(np.round(p_goal, 6)).shape[0], \"unique probs (rounded)\")\n",
        "df_spotting_summary = pd.DataFrame(rows)\n",
        "display(df_spotting_summary.sort_values([\"ts_F1\", \"win_F1\"], ascending=False).head(20))\n",
        "\n",
        "# Optional: plot p_goal for the best / worst half by ts_F1\n",
        "if len(df_spotting_summary) > 0:\n",
        "    best_path = df_spotting_summary.sort_values(\"ts_F1\", ascending=False).iloc[0][\"video_path\"]\n",
        "    print(\"\\nPlotting p_goal for best half:\", best_path)\n",
        "    centers, p_goal, pred_times, pred_scores = spot_goals_sliding_window_batched(\n",
        "        best_path,\n",
        "        clip_sec=CLIP_SEC, stride_sec=STRIDE_SEC, num_frames=NUM_FRAMES, size=SIZE,\n",
        "        threshold=THRESHOLD, nms_sep_sec=NMS_SEP_SEC, max_seconds=MAX_SECONDS_PER_HALF\n",
        "    )\n",
        "    fig, ax = plt.subplots(figsize=(14, 3))\n",
        "    ax.plot(centers, p_goal)\n",
        "    if len(pred_times) > 0:\n",
        "        ax.scatter(pred_times, pred_scores, marker=\"x\", label=\"Predicted goals (after NMS)\")\n",
        "    ax.set_title(\"Sliding-window goal spotting (best half by timestamp-F1)\")\n",
        "    ax.set_xlabel(\"Time (s)\")\n",
        "    ax.set_ylabel(\"P(goal)\")\n",
        "    ax.set_ylim(0, 1)\n",
        "    ax.legend()\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n"
      ]
    }
  ],
