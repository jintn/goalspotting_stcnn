      ],
      "source": [
        "# CELL — Sliding-window goal spotting (1s stride) on a RANDOM validation half (mkv) — SEQUENTIAL DECODE + BATCHED\n",
        "\n",
        "import cv2\n",
        "import numpy as np\n",
        "import torch\n",
        "import matplotlib.pyplot as plt\n",
        "import pandas as pd\n",
        "import random\n",
        "from collections import deque\n",
        "\n",
        "device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
        "model.to(device).eval()\n",
        "torch.backends.cudnn.benchmark = True  # small speed boost for fixed shapes\n",
        "\n",
        "assert \"goal\" in label2id, \"Label 'goal' not in label2id\"\n",
        "goal_id = label2id[\"goal\"]\n",
        "\n",
        "# -------------------------\n",
        "# Pick a random validation half (video_path) from df_valid\n",
        "# -------------------------\n",
        "assert \"df_valid\" in globals(), \"df_valid not found. Make sure you've created df_valid from your manifest.\"\n",
        "assert \"video_path\" in df_valid.columns, \"df_valid must contain a 'video_path' column.\"\n",
        "\n",
        "SEED = 42\n",
        "random.seed(SEED)\n",
        "np.random.seed(SEED)\n",
        "\n",
        "valid_paths = df_valid[\"video_path\"].dropna().unique().tolist()\n",
        "valid_paths = [p for p in valid_paths if isinstance(p, str) and len(p) > 0]\n",
        "\n",
        "if len(valid_paths) == 0:\n",
        "    raise RuntimeError(\"No valid video paths found in df_valid.\")\n",
        "\n",
        "VIDEO_PATH = random.choice(valid_paths)\n",
        "print(\"Random validation half:\", VIDEO_PATH)\n",
        "\n",
        "# Optional: print which game/half it came from (if columns exist)\n",
        "cols = [c for c in [\"rel_game\", \"half\"] if c in df_valid.columns]\n",
        "if cols:\n",
        "    ex = df_valid[df_valid[\"video_path\"] == VIDEO_PATH].iloc[0]\n",
        "    print(\"Meta:\", {c: ex[c] for c in cols})\n",
        "\n",
        "# -------------------------\n",
        "# Helpers\n",
        "# -------------------------\n",
        "def video_duration_fps(video_path: str):\n",
        "    cap = cv2.VideoCapture(video_path)\n",
        "    if not cap.isOpened():\n",
        "        raise RuntimeError(f\"Could not open video: {video_path}\")\n",
        "    fps = cap.get(cv2.CAP_PROP_FPS) or 25.0\n",
        "    n = cap.get(cv2.CAP_PROP_FRAME_COUNT) or 0\n",
        "    cap.release()\n",
        "    if n <= 1:\n",
        "        raise RuntimeError(f\"Could not read frame count for: {video_path}\")\n",
        "    return float(n / fps), float(fps)\n",
        "\n",
        "def nms_1d(times, scores, min_separation_sec=8.0):\n",
        "    \"\"\"Greedy NMS on 1D timestamps: keep highest score, suppress within +/- min_separation_sec/2.\"\"\"\n",
        "    if len(times) == 0:\n",
        "        return np.array([]), np.array([])\n",
        "    order = np.argsort(scores)[::-1]\n",
        "    keep = []\n",
        "    suppressed = np.zeros(len(times), dtype=bool)\n",
        "    half = min_separation_sec / 2.0\n",
        "\n",
        "    for i in order:\n",
        "        if suppressed[i]:\n",
        "            continue\n",
        "        keep.append(i)\n",
        "        close = np.abs(times - times[i]) <= half\n",
        "        suppressed |= close\n",
        "        suppressed[i] = False\n",
        "\n",
        "    keep = np.array(keep, dtype=int)\n",
        "    korder = np.argsort(times[keep])\n",
        "    return times[keep][korder], scores[keep][korder]\n",
        "\n",
        "def extract_clip_cv2(video_path, center_sec, clip_sec=4.0, num_frames=16, size=112):\n",
        "    cap = cv2.VideoCapture(video_path)\n",
        "    if not cap.isOpened():\n",
        "        raise RuntimeError(f\"Could not open video: {video_path}\")\n",
        "\n",
        "    fps = cap.get(cv2.CAP_PROP_FPS) or 25.0\n",
        "    start_sec = max(0.0, float(center_sec) - clip_sec / 2)\n",
        "    start_frame = int(start_sec * fps)\n",
        "\n",
        "    frames = []\n",
        "    step = int(max(1, (clip_sec * fps) / num_frames))\n",
        "\n",
        "    for i in range(num_frames):\n",
        "        cap.set(cv2.CAP_PROP_POS_FRAMES, start_frame + i * step)\n",
        "        ok, frame = cap.read()\n",
        "        if not ok:\n",
        "            break\n",
        "        frame = cv2.resize(frame, (size, size), interpolation=cv2.INTER_AREA)\n",
        "        frame = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)\n",
        "        frames.append(frame)\n",
        "\n",
        "    cap.release()\n",
        "\n",
        "    if len(frames) == 0:\n",
        "        raise RuntimeError(f\"No frames read from: {video_path}\")\n",
        "\n",
        "    while len(frames) < num_frames:\n",
        "        frames.append(frames[-1].copy())\n",
        "\n",
        "    arr = np.stack(frames, axis=0).astype(np.float32) / 255.0  # (T,H,W,C)\n",
        "    arr = np.transpose(arr, (3, 0, 1, 2))  # (C,T,H,W)\n",
        "    return torch.from_numpy(arr)\n",
        "\n",
        "def spot_goals_sliding_window_slow(\n",
        "    video_path,\n",
        "    clip_sec=4.0,\n",
        "    stride_sec=1.0,\n",
        "    num_frames=16,\n",
        "    size=112,\n",
        "    threshold=0.998,\n",
        "    nms_sep_sec=20.0,\n",
        "    max_seconds=None,\n",
        "):\n",
        "    dur, _ = video_duration_fps(video_path)\n",
        "    end_time = dur if max_seconds is None else min(dur, float(max_seconds))\n",
        "\n",
        "    t0 = clip_sec / 2.0\n",
        "    t1 = end_time - clip_sec / 2.0\n",
        "    centers = np.arange(t0, t1 + 1e-9, stride_sec, dtype=np.float32)\n",
        "\n",
        "    probs = np.empty(len(centers), dtype=np.float32)\n",
        "    with torch.no_grad():\n",
        "        for i, c in enumerate(centers):\n",
        "            x = extract_clip_cv2(video_path, c, clip_sec=clip_sec, num_frames=num_frames, size=size)\n",
        "            x = x.unsqueeze(0).to(device)  # [1,C,T,H,W]\n",
        "            logits = model(x)\n",
        "            probs[i] = torch.softmax(logits, dim=1)[0, goal_id].item()\n",
        "\n",
        "    det_mask = probs >= threshold\n",
        "    det_times = centers[det_mask]\n",
        "    det_scores = probs[det_mask]\n",
        "    final_times, final_scores = nms_1d(det_times, det_scores, min_separation_sec=nms_sep_sec)\n",
        "    return centers, probs, final_times, final_scores\n",
        "\n",
        "def spot_goals_sliding_window_sequential_batched(\n",
        "    video_path,\n",
        "    clip_sec=4.0,\n",
        "    stride_sec=1.0,\n",
        "    num_frames=16,\n",
        "    size=112,\n",
        "    threshold=0.998,\n",
        "    nms_sep_sec=20.0,\n",
        "    max_seconds=None,\n",
        "    batch_size=64,\n",
        "    use_amp=True,\n",
        "):\n",
        "    # open once\n",
        "    cap = cv2.VideoCapture(video_path)\n",
        "    if not cap.isOpened():\n",
        "        raise RuntimeError(f\"Could not open video: {video_path}\")\n",
        "\n",
        "    fps = cap.get(cv2.CAP_PROP_FPS) or 25.0\n",
        "    total_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT) or 0)\n",
        "\n",
        "    # scan limit\n",
        "    if max_seconds is None:\n",
        "        end_frame_scan = total_frames - 1\n",
        "    else:\n",
        "        end_frame_scan = min(total_frames - 1, int(float(max_seconds) * fps))\n",
        "\n",
        "    clip_frames = int(round(clip_sec * fps))          # 4s * 25fps = 100 frames\n",
        "    half = clip_frames // 2\n",
        "    stride_frames = max(1, int(round(stride_sec * fps)))  # 1s * 25fps = 25 frames\n",
        "\n",
        "    # centers in frame indices\n",
        "    first_center = half\n",
        "    last_center = end_frame_scan - half\n",
        "    if last_center <= first_center:\n",
        "        cap.release()\n",
        "        raise RuntimeError(\"Video too short for chosen clip_sec/max_seconds.\")\n",
        "\n",
        "    dur, _ = video_duration_fps(video_path)\n",
        "    end_time = dur if max_seconds is None else min(dur, float(max_seconds))\n",
        "\n",
        "    t0 = clip_sec / 2.0\n",
        "    t1 = end_time - clip_sec / 2.0\n",
        "    centers_sec = np.arange(t0, t1 + 1e-9, stride_sec, dtype=np.float32)\n",
        "    center_frames = np.round(centers_sec * fps).astype(int)\n",
        "\n",
        "    # ring buffer: must cover at least full clip + a bit\n",
        "    buffer_maxlen = clip_frames + stride_frames + 10\n",
        "    buf = deque(maxlen=buffer_maxlen)  # stores (frame_idx, frame_rgb_resized)\n",
        "\n",
        "    probs = np.empty(len(center_frames), dtype=np.float32)\n",
        "\n",
        "    next_center_i = 0\n",
        "    current_frame_idx = -1\n",
        "\n",
        "    batch_clips = []\n",
        "    batch_out_indices = []\n",
        "\n",
        "    def build_clip_from_buffer(start_f, end_f):\n",
        "        # frame lookup (buffer is small, so dict build is cheap)\n",
        "        frame_map = {fi: fr for fi, fr in buf}\n",
        "\n",
        "        # sample exactly num_frames indices over the interval\n",
        "        step = int(max(1, (clip_sec * fps) / num_frames))  # same as slow\n",
        "        idxs = start_f + np.arange(num_frames) * step\n",
        "        idxs = np.clip(idxs, start_f, end_f - 1).astype(int)\n",
        "\n",
        "        frames = []\n",
        "        last = None\n",
        "        for fi in idxs:\n",
        "            fr = frame_map.get(fi, None)\n",
        "            if fr is None:\n",
        "                fr = last  # fallback (rare)\n",
        "            if fr is None:\n",
        "                raise RuntimeError(\"Buffer miss. Increase buffer_maxlen.\")\n",
        "            frames.append(fr)\n",
        "            last = fr\n",
        "\n",
        "        arr = np.stack(frames, axis=0).astype(np.float32) / 255.0  # (T,H,W,C)\n",
        "        arr = np.transpose(arr, (3, 0, 1, 2))  # (C,T,H,W)\n",
        "        return torch.from_numpy(arr)\n",
        "\n",
        "    with torch.no_grad():\n",
        "        while current_frame_idx < end_frame_scan:\n",
        "            ok, frame = cap.read()\n",
        "            if not ok:\n",
        "                break\n",
        "            current_frame_idx += 1\n",
        "\n",
        "            # preprocess once per decoded frame\n",
        "            frame = cv2.resize(frame, (size, size), interpolation=cv2.INTER_AREA)\n",
        "            frame = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)\n",
        "            buf.append((current_frame_idx, frame))\n",
        "\n",
        "            # process centers when their window end is available\n",
        "            while next_center_i < len(center_frames):\n",
        "                cf = center_frames[next_center_i]\n",
        "                start_f = cf - half\n",
        "                end_f = cf + half  # end frame (exclusive-ish)\n",
        "\n",
        "                # only build when we've decoded up to end_f-1\n",
        "                if current_frame_idx < (end_f - 1):\n",
        "                    break\n",
        "\n",
        "                clip = build_clip_from_buffer(start_f, end_f)\n",
        "                batch_clips.append(clip)\n",
        "                batch_out_indices.append(next_center_i)\n",
        "                next_center_i += 1\n",
        "\n",
        "                if len(batch_clips) >= batch_size:\n",
        "                    x = torch.stack(batch_clips, dim=0).to(device)  # [B,C,T,H,W]\n",
        "                    if device == \"cuda\":\n",
        "                        with torch.cuda.amp.autocast(enabled=use_amp):\n",
        "                            logits = model(x)\n",
        "                            p = torch.softmax(logits, dim=1)[:, goal_id]\n",
        "                    else:\n",
        "                        logits = model(x)\n",
        "                        p = torch.softmax(logits, dim=1)[:, goal_id]\n",
        "\n",
        "                    probs[np.array(batch_out_indices, dtype=int)] = p.detach().float().cpu().numpy()\n",
        "                    batch_clips.clear()\n",
        "                    batch_out_indices.clear()\n",
        "\n",
        "        # flush leftover batch\n",
        "        if len(batch_clips) > 0:\n",
        "            x = torch.stack(batch_clips, dim=0).to(device)\n",
        "            if device == \"cuda\":\n",
        "                with torch.cuda.amp.autocast(enabled=use_amp):\n",
        "                    logits = model(x)\n",
        "                    p = torch.softmax(logits, dim=1)[:, goal_id]\n",
        "            else:\n",
        "                logits = model(x)\n",
        "                p = torch.softmax(logits, dim=1)[:, goal_id]\n",
        "            probs[np.array(batch_out_indices, dtype=int)] = p.detach().float().cpu().numpy()\n",
        "\n",
        "    cap.release()\n",
        "\n",
        "    det_mask = probs >= threshold\n",
        "    det_times = centers_sec[det_mask]\n",
        "    det_scores = probs[det_mask]\n",
        "    final_times, final_scores = nms_1d(det_times, det_scores, min_separation_sec=nms_sep_sec)\n",
        "    return centers_sec, probs, final_times, final_scores\n",
        "\n",
        "# -------------------------\n",
        "# Run spotting (SEQUENTIAL)\n",
        "# -------------------------\n",
        "centers, p_goal, pred_times, pred_scores = spot_goals_sliding_window_sequential_batched(\n",
        "    VIDEO_PATH,\n",
        "    clip_sec=4.0,\n",
        "    stride_sec=1.0,\n",
        "    num_frames=16,\n",
        "    size=112,\n",
        "    threshold=0.998,\n",
        "    nms_sep_sec=20.0,\n",
        "    max_seconds=None,\n",
        "    batch_size=64,     \n",
        "    use_amp=True,\n",
        ")\n",
        "\n",
        "\n",
        "import time\n",
        "\n",
        "THR = 0.998\n",
        "TOL = 5.0  # seconds\n",
        "\n",
        "def match_events(a_times, b_times, tol=5.0):\n",
        "    a_times = np.asarray(a_times, dtype=np.float32)\n",
        "    b_times = np.asarray(b_times, dtype=np.float32)\n",
        "    used = np.zeros(len(b_times), dtype=bool)\n",
        "    m = 0\n",
        "    for at in a_times:\n",
        "        if len(b_times) == 0:\n",
        "            continue\n",
        "        d = np.abs(b_times - at)\n",
        "        j = int(np.argmin(d))\n",
        "        if (not used[j]) and d[j] <= tol:\n",
        "            used[j] = True\n",
        "            m += 1\n",
        "    return m\n",
        "\n",
        "def summarize(name, centers, p, times):\n",
        "    print(f\"\\n{name}\")\n",
        "    print(\"  windows:\", len(centers))\n",
        "    print(f\"  windows >= {THR}:\", int((p >= THR).sum()))\n",
        "    print(\"  pred events after NMS:\", len(times))\n",
        "    print(\"  p min/max:\", float(p.min()), float(p.max()))\n",
        "    print(\"  p quantiles:\", np.quantile(p, [0.99, 0.999, 0.9995, 0.9999]))\n",
        "\n",
        "# already computed:\n",
        "seq_centers, seq_p, seq_times = centers, p_goal, pred_times\n",
        "summarize(\"SEQUENTIAL (AMP ON)\", seq_centers, seq_p, seq_times)\n",
        "\n",
        "# sequential AMP OFF\n",
        "t0 = time.time()\n",
        "centers_off, p_off, times_off, _ = spot_goals_sliding_window_sequential_batched(\n",
        "    VIDEO_PATH,\n",
        "    clip_sec=4.0, stride_sec=1.0, num_frames=16, size=112,\n",
        "    threshold=THR, nms_sep_sec=20.0, max_seconds=None,\n",
        "    batch_size=64, use_amp=False,\n",
        ")\n",
        "print(\"Time SEQ AMP OFF:\", round(time.time() - t0, 2), \"s\")\n",
        "summarize(\"SEQUENTIAL (AMP OFF)\", centers_off, p_off, times_off)\n",
        "\n",
        "# slow baseline\n",
        "t0 = time.time()\n",
        "centers_slow, p_slow, times_slow, _ = spot_goals_sliding_window_slow(\n",
        "    VIDEO_PATH,\n",
        "    clip_sec=4.0, stride_sec=1.0, num_frames=16, size=112,\n",
        "    threshold=THR, nms_sep_sec=20.0, max_seconds=None,\n",
        ")\n",
        "print(\"Time SLOW:\", round(time.time() - t0, 2), \"s\")\n",
        "summarize(\"SLOW baseline\", centers_slow, p_slow, times_slow)\n",
        "\n",
        "# Compare arrays (should align on centers)\n",
        "if len(seq_centers) == len(centers_slow):\n",
        "    mean_abs = float(np.mean(np.abs(seq_p - p_slow)))\n",
        "    max_abs = float(np.max(np.abs(seq_p - p_slow)))\n",
        "    flips = int(np.sum((seq_p >= THR) != (p_slow >= THR)))\n",
        "    matched = match_events(seq_times, times_slow, tol=TOL)\n",
        "\n",
        "    print(\"\\nSEQ(AMP ON) vs SLOW\")\n",
        "    print(\"  mean |diff|:\", mean_abs)\n",
        "    print(\"  max  |diff|:\", max_abs)\n",
        "    print(f\"  threshold flips @ {THR}:\", flips)\n",
        "    print(f\"  matched events within ±{TOL}s:\", matched, f\"(seq={len(seq_times)} slow={len(times_slow)})\")\n",
        "\n",
        "if len(seq_centers) == len(centers_off):\n",
        "    mean_abs = float(np.mean(np.abs(seq_p - p_off)))\n",
        "    max_abs = float(np.max(np.abs(seq_p - p_off)))\n",
        "    flips = int(np.sum((seq_p >= THR) != (p_off >= THR)))\n",
        "    matched = match_events(seq_times, times_off, tol=TOL)\n",
        "\n",
        "    print(\"\\nSEQ AMP ON vs AMP OFF\")\n",
        "    print(\"  mean |diff|:\", mean_abs)\n",
        "    print(\"  max  |diff|:\", max_abs)\n",
        "    print(f\"  threshold flips @ {THR}:\", flips)\n",
        "    print(f\"  matched events within ±{TOL}s:\", matched, f\"(on={len(seq_times)} off={len(times_off)})\")\n",
        "\n",
        "\n",
        "print(f\"\\nWindows evaluated: {len(centers)}\")\n",
        "print(\"Predicted goal timestamps (sec):\")\n",
        "for t, s in zip(pred_times, pred_scores):\n",
        "    print(f\"  t={t:7.2f}s   P(goal)={s:.3f}\")\n",
        "\n",
        "# Plot signal + detections\n",
        "fig, ax = plt.subplots(figsize=(14, 3))\n",
        "ax.plot(centers, p_goal)\n",
        "if len(pred_times) > 0:\n",
        "    ax.scatter(pred_times, pred_scores, marker=\"x\", label=\"Predicted goals (after NMS)\")\n",
        "ax.set_title(\"Sliding-window goal spotting on random validation half (1s stride) — sequential decode\")\n",
        "ax.set_xlabel(\"Time (s)\")\n",
        "ax.set_ylabel(\"P(goal)\")\n",
        "ax.set_ylim(0, 1)\n",
        "ax.legend()\n",
        "plt.tight_layout()\n",
        "plt.show()\n"
      ]
    },
