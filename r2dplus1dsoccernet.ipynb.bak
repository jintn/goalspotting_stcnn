        "id": "zX6gmKxUTcrF",
        "outputId": "96acdff8-fb76-40f5-e149-bb98550fc0e7"
      },
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "train rows: 10627\n",
            "valid rows: 3639\n",
            "labels: ['background', 'goal', 'soff', 'son']\n",
            "num_classes: 4\n",
            "Loaders ready.\n"
          ]
        }
      ],
      "source": [
        "import cv2\n",
        "import numpy as np\n",
        "import torch\n",
        "from torch.utils.data import Dataset, DataLoader\n",
        "import pandas as pd\n",
        "\n",
        "\n",
        "df_all = pd.read_csv(MANIFEST_PATH)\n",
        "df_train = df_all[df_all[\"split\"] == \"train\"].reset_index(drop=True)\n",
        "df_valid = df_all[df_all[\"split\"] == \"valid\"].reset_index(drop=True)\n",
        "\n",
        "print(\"train rows:\", len(df_train))\n",
        "print(\"valid rows:\", len(df_valid))\n",
        "\n",
        "# labels from train only\n",
        "labels = sorted(df_train[\"label\"].unique().tolist())\n",
        "label2id = {l:i for i,l in enumerate(labels)}\n",
        "num_classes = len(labels)\n",
        "print(\"labels:\", labels)\n",
        "print(\"num_classes:\", num_classes)\n",
        "\n",
        "def extract_clip_cv2(video_path, center_sec, clip_sec=4.0, num_frames=16, size=112):\n",
        "    cap = cv2.VideoCapture(video_path)\n",
        "    if not cap.isOpened():\n",
        "        raise RuntimeError(f\"Could not open video: {video_path}\")\n",
        "\n",
        "    fps = cap.get(cv2.CAP_PROP_FPS) or 25.0\n",
        "    start_sec = max(0.0, center_sec - clip_sec/2)\n",
        "    start_frame = int(start_sec * fps)\n",
        "\n",
        "    frames = []\n",
        "    step = int(max(1, (clip_sec * fps) / num_frames))\n",
        "\n",
        "    for i in range(num_frames):\n",
        "        cap.set(cv2.CAP_PROP_POS_FRAMES, start_frame + i*step)\n",
        "        ok, frame = cap.read()\n",
        "        if not ok:\n",
        "            break\n",
        "        frame = cv2.resize(frame, (size, size), interpolation=cv2.INTER_AREA)\n",
        "        frame = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)\n",
        "        frames.append(frame)\n",
        "\n",
        "    cap.release()\n",
        "\n",
        "    if len(frames) == 0:\n",
        "        raise RuntimeError(f\"No frames read from: {video_path}\")\n",
        "\n",
        "    while len(frames) < num_frames:\n",
        "        frames.append(frames[-1].copy())\n",
        "\n",
        "    arr = np.stack(frames, axis=0).astype(np.float32) / 255.0  # (T,H,W,C)\n",
        "    arr = np.transpose(arr, (3,0,1,2))  # (C,T,H,W)\n",
        "    return torch.from_numpy(arr)\n",
        "\n",
        "class SoccerNetClipDataset(Dataset):\n",
        "    def __init__(self, df, label2id, clip_sec=4.0, num_frames=16, size=112):\n",
        "        self.df = df.reset_index(drop=True)\n",
        "        self.label2id = label2id\n",
        "        self.clip_sec = clip_sec\n",
        "        self.num_frames = num_frames\n",
        "        self.size = size\n",
        "\n",
        "    def __len__(self):\n",
        "        return len(self.df)\n",
        "\n",
        "    def __getitem__(self, idx):\n",
        "        r = self.df.iloc[idx]\n",
        "        x = extract_clip_cv2(r.video_path, r.center_sec, self.clip_sec, self.num_frames, self.size)\n",
        "        y = self.label2id[r.label]\n",
        "        return x, torch.tensor(y, dtype=torch.long)\n",
        "\n",
        "train_ds = SoccerNetClipDataset(df_train, label2id, clip_sec=4.0, num_frames=16, size=112)\n",
        "val_ds   = SoccerNetClipDataset(df_valid, label2id, clip_sec=4.0, num_frames=16, size=112)\n",
        "\n",
        "train_loader = DataLoader(\n",
        "    train_ds,\n",
        "    batch_size=12,\n",
        "    shuffle=True,\n",
        "    num_workers=8,          \n",
        "    pin_memory=True,\n",
        "    persistent_workers=False,\n",
        "    prefetch_factor=4,\n",
        ")\n",
        "\n",
        "val_loader = DataLoader(\n",
        "    val_ds,\n",
        "    batch_size=16,\n",
        "    shuffle=False,\n",
        "    num_workers=6,          \n",
        "    pin_memory=True,\n",
        "    persistent_workers=False,\n",
        "    prefetch_factor=4,\n",
        ")\n",
        "\n",
        "print(\"Loaders ready.\")\n"
      ]
    },
