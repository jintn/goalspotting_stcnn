      "source": [
        "# CELL — Binary Train + Val (goal vs non-goal) with AMP + metrics\n",
        "\n",
        "from tqdm import tqdm\n",
        "import os\n",
        "import torch\n",
        "from torch.amp import autocast, GradScaler\n",
        "import numpy as np\n",
        "\n",
        "EPOCHS = 10\n",
        "\n",
        "use_amp = (device == \"cuda\")\n",
        "scaler = GradScaler(\"cuda\") if use_amp else None\n",
        "\n",
        "BEST = f\"{CKPT_DIR}/best_bin.pt\"\n",
        "LATEST = f\"{CKPT_DIR}/latest_bin.pt\"\n",
        "best_score = -1.0  # we’ll save best by goal F1 (or macro_F1)\n",
        "\n",
        "# --- binary label mapping (for reporting/checkpoint) ---\n",
        "label2id_bin = {\"non_goal\": 0, \"goal\": 1}\n",
        "id2label_bin = {v: k for k, v in label2id_bin.items()}\n",
        "\n",
        "# --- find goal id in your ORIGINAL mapping ---\n",
        "assert \"goal\" in label2id, \"Label 'goal' not in label2id\"\n",
        "goal_id_orig = label2id[\"goal\"]\n",
        "\n",
        "# --- make model binary head (2 classes) ---\n",
        "# IMPORTANT: do this before training (and before loading a 4-class checkpoint)\n",
        "model.fc = torch.nn.Linear(model.fc.in_features, 2).to(device)\n",
        "\n",
        "# optionally: binary class weights (tune)\n",
        "# Try w_goal in [2, 4, 6] if recall is low\n",
        "w_goal = 4.0\n",
        "criterion = torch.nn.CrossEntropyLoss(weight=torch.tensor([1.0, w_goal], device=device))\n",
        "\n",
        "# optimizer (keep yours if you want)\n",
        "# optimizer = torch.optim.Adam(model.parameters(), lr=1e-4, weight_decay=1e-4)\n",
        "\n",
        "def confusion_matrix_torch(y_true, y_pred, num_classes: int) -> torch.Tensor:\n",
        "    k = (y_true >= 0) & (y_true < num_classes)\n",
        "    y_true = y_true[k]\n",
        "    y_pred = y_pred[k]\n",
        "    idx = y_true * num_classes + y_pred\n",
        "    cm = torch.bincount(idx, minlength=num_classes**2).reshape(num_classes, num_classes)\n",
        "    return cm\n",
        "\n",
        "def per_class_from_cm(cm: torch.Tensor, eps: float = 1e-12):\n",
        "    cm = cm.float()\n",
        "    tp = torch.diag(cm)\n",
        "    support = cm.sum(dim=1)\n",
        "    pred_cnt = cm.sum(dim=0)\n",
        "\n",
        "    precision = tp / (pred_cnt + eps)\n",
        "    recall = tp / (support + eps)\n",
        "    f1 = 2 * precision * recall / (precision + recall + eps)\n",
        "\n",
        "    acc = tp.sum() / (cm.sum() + eps)\n",
        "    macro_f1 = f1.mean()\n",
        "    weighted_f1 = (f1 * support / (support.sum() + eps)).sum()\n",
        "\n",
        "    return {\n",
        "        \"acc\": float(acc.item()),\n",
        "        \"precision\": precision.detach().cpu().numpy(),\n",
        "        \"recall\": recall.detach().cpu().numpy(),\n",
        "        \"f1\": f1.detach().cpu().numpy(),\n",
        "        \"support\": support.detach().cpu().numpy().astype(int),\n",
        "        \"macro_f1\": float(macro_f1.item()),\n",
        "        \"weighted_f1\": float(weighted_f1.item()),\n",
        "    }\n",
        "\n",
        "def save_ckpt(path, model, optim, epoch, label2id_to_save):\n",
        "    os.makedirs(os.path.dirname(path), exist_ok=True)\n",
        "    torch.save(\n",
        "        {\n",
        "            \"epoch\": epoch,\n",
        "            \"model\": model.state_dict(),\n",
        "            \"optim\": optim.state_dict(),\n",
        "            \"label2id\": label2id_to_save,\n",
        "        },\n",
        "        path,\n",
        "    )\n",
        "\n",
        "start_epoch_bin = 0  # binary training from scratch\n",
        "\n",
        "for epoch in range(start_epoch_bin, start_epoch_bin + EPOCHS):\n",
        "    # ---- train ----\n",
        "    model.train()\n",
        "    running = 0.0\n",
        "    pbar = tqdm(train_loader, desc=f\"Epoch {epoch+1} [train/bin]\")\n",
        "\n",
        "    for x, y in pbar:\n",
        "        x = x.to(device, non_blocking=True)\n",
        "        y = y.to(device, non_blocking=True)\n",
        "\n",
        "        # map to binary: 1 if goal else 0\n",
        "        y_bin = (y == goal_id_orig).long()\n",
        "\n",
        "        optimizer.zero_grad(set_to_none=True)\n",
        "\n",
        "        with autocast(device_type=\"cuda\", enabled=use_amp):\n",
        "            logits = model(x)           # [B,2]\n",
        "            loss = criterion(logits, y_bin)\n",
        "\n",
        "        if use_amp:\n",
        "            scaler.scale(loss).backward()\n",
        "            scaler.step(optimizer)\n",
        "            scaler.update()\n",
        "        else:\n",
        "            loss.backward()\n",
        "            optimizer.step()\n",
        "\n",
        "        running += loss.item()\n",
        "        pbar.set_postfix(train_loss=running / (pbar.n + 1))\n",
        "\n",
        "    # ---- validate ----\n",
        "    model.eval()\n",
        "    correct, total = 0, 0\n",
        "\n",
        "    num_classes = 2\n",
        "    cm = torch.zeros((num_classes, num_classes), device=device, dtype=torch.int64)\n",
        "\n",
        "    with torch.no_grad():\n",
        "        pbarval = tqdm(val_loader, desc=f\"Epoch {epoch+1} [val/bin]\")\n",
        "        for x, y in pbarval:\n",
        "            x = x.to(device, non_blocking=True)\n",
        "            y = y.to(device, non_blocking=True)\n",
        "\n",
        "            y_bin = (y == goal_id_orig).long()\n",
        "\n",
        "            logits = model(x)\n",
        "            preds = logits.argmax(dim=1)\n",
        "\n",
        "            correct += (preds == y_bin).sum().item()\n",
        "            total += y_bin.size(0)\n",
        "\n",
        "            cm += confusion_matrix_torch(y_bin, preds, num_classes)\n",
        "\n",
        "            pbarval.set_postfix(val_acc=correct / max(total, 1))\n",
        "\n",
        "    val_acc = correct / max(total, 1)\n",
        "    stats = per_class_from_cm(cm)\n",
        "\n",
        "    goal_f1 = float(stats[\"f1\"][label2id_bin[\"goal\"]])\n",
        "    goal_p  = float(stats[\"precision\"][label2id_bin[\"goal\"]])\n",
        "    goal_r  = float(stats[\"recall\"][label2id_bin[\"goal\"]])\n",
        "\n",
        "    print(\n",
        "        f\"Epoch {epoch+1} | \"\n",
        "        f\"val acc: {val_acc:.4f} | \"\n",
        "        f\"macro_F1: {stats['macro_f1']:.4f} | \"\n",
        "        f\"goal P/R/F1: {goal_p:.3f}/{goal_r:.3f}/{goal_f1:.3f}\"\n",
        "    )\n",
        "\n",
        "    for c in range(num_classes):\n",
        "        name = id2label_bin.get(c, str(c))\n",
        "        print(\n",
        "            f\"  {c:2d} {name:10s}  \"\n",
        "            f\"P={stats['precision'][c]:.3f}  \"\n",
        "            f\"R={stats['recall'][c]:.3f}  \"\n",
        "            f\"F1={stats['f1'][c]:.3f}  \"\n",
        "            f\"support={stats['support'][c]}\"\n",
        "        )\n",
        "\n",
        "    # ---- save latest ----\n",
        "    save_ckpt(LATEST, model, optimizer, epoch + 1, label2id_bin)\n",
        "\n",
        "    # ---- save best by GOAL F1 (recommended for spotting) ----\n",
        "    score = goal_f1\n",
        "    if score > best_score:\n",
        "        best_score = score\n",
        "        save_ckpt(BEST, model, optimizer, epoch + 1, label2id_bin)\n",
        "        print(\"Saved BEST:\", BEST, \"goal_F1:\", best_score)\n",
        "\n",
        "print(\"Binary training done.\")\n"
      ]
    },
