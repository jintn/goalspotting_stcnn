      "source": [
        "import torch, os\n",
        "from torchvision.models.video import r2plus1d_18\n",
        "\n",
        "device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
        "print(\"device:\", device)\n",
        "\n",
        "model = r2plus1d_18(weights=\"DEFAULT\")\n",
        "model.fc = torch.nn.Linear(model.fc.in_features, num_classes)\n",
        "model = model.to(device)\n",
        "\n",
        "optimizer = torch.optim.Adam(model.parameters(), lr=3e-5, weight_decay=1e-4)\n",
        "criterion = torch.nn.CrossEntropyLoss()\n",
        "\n",
        "LATEST = f\"{CKPT_DIR}/latest.pt\"\n",
        "BEST   =  f\"{CKPT_DIR}/best.pt\"\n",
        "\n",
        "def load_ckpt(path, model, optim=None, map_location=\"cpu\"):\n",
        "    ckpt = torch.load(path, map_location=map_location)\n",
        "    model.load_state_dict(ckpt[\"model\"])\n",
        "    if optim is not None and \"optim\" in ckpt:\n",
        "        optim.load_state_dict(ckpt[\"optim\"])\n",
        "    return ckpt.get(\"epoch\", 0), ckpt.get(\"label2id\", None)\n",
        "\n",
        "start_epoch = 0\n",
        "resume_path = BEST if os.path.exists(BEST) else (LATEST if os.path.exists(LATEST) else None)\n",
        "\n",
        "if resume_path:\n",
        "    start_epoch, saved_label2id = load_ckpt(resume_path, model, optimizer, map_location=device)\n",
        "    print(\"Resumed from:\", resume_path, \"epoch:\", start_epoch)\n",
        "    if saved_label2id is not None and saved_label2id != label2id:\n",
        "        print(\"WARNING: label2id mismatch vs checkpoint (check manifest/labels).\")\n",
        "else:\n",
        "    print(\"No checkpoint found, training from scratch.\")\n",
        "\n",
        "print(\"Model device check:\", next(model.parameters()).device)\n"
      ]
    },
