      },
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "Using root: /home/jinny/aspotting/dataset\n",
            "Found JSON files: 500\n",
            "Rows: 2011\n",
            "\n",
            "Label counts:\n",
            " label\n",
