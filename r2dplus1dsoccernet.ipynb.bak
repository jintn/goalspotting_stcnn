      "source": [
        "# CELL 8 — Model + optimizer \n",
        "import torch\n",
        "from torchvision.models.video import r2plus1d_18\n",
        "\n",
        "device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
        "\n",
        "model = r2plus1d_18(weights=\"DEFAULT\")  # pretrained\n",
        "model.fc = torch.nn.Linear(model.fc.in_features, num_classes)\n",
        "model = model.to(device)\n",
        "\n",
        "optimizer = torch.optim.Adam(model.parameters(), lr=1e-4)\n",
        "criterion = torch.nn.CrossEntropyLoss()\n",
        "\n",
        "LATEST = f\"{CKPT_DIR}/latest.pt\"\n",
        "\n",
        "def save_ckpt(path, model, optim, epoch, label2id):\n",
        "    os.makedirs(os.path.dirname(path), exist_ok=True)\n",
        "    torch.save({\n",
        "        \"epoch\": epoch,\n",
        "        \"model\": model.state_dict(),\n",
        "        \"optim\": optim.state_dict(),\n",
        "        \"label2id\": label2id\n",
        "    }, path)\n",
        "\n",
        "def load_ckpt(path, model, optim=None, map_location=\"cpu\"):\n",
        "    ckpt = torch.load(path, map_location=map_location)\n",
        "    model.load_state_dict(ckpt[\"model\"])\n",
        "    if optim is not None and \"optim\" in ckpt:\n",
        "        optim.load_state_dict(ckpt[\"optim\"])\n",
        "    return ckpt.get(\"epoch\", 0), ckpt.get(\"label2id\", None)\n",
        "\n",
        "start_epoch = 0\n",
        "if os.path.exists(LATEST):\n",
        "    start_epoch, saved_label2id = load_ckpt(LATEST, model, optimizer, map_location=device)\n",
        "    print(\"Resumed from epoch:\", start_epoch)\n",
        "    # sanity: labels should match\n",
        "    if saved_label2id is not None and saved_label2id != label2id:\n",
        "        print(\"WARNING: label mapping differs from checkpoint. You should keep a stable manifest/labels.\")\n",
        "else:\n",
        "    print(\"No checkpoint found, training from scratch.\")\n"
      ]
    },
