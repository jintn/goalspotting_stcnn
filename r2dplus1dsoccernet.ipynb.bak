      ],
      "source": [
        "# Loader for test\n",
        "\n",
        "# CELL 7 — Clip loader + Dataset (TEST only, on-the-fly clips)\n",
        "\n",
        "import cv2\n",
        "import numpy as np\n",
        "import torch\n",
        "from torch.utils.data import Dataset, DataLoader\n",
        "import pandas as pd\n",
        "import os\n",
        "\n",
        "# -------------------------\n",
        "# Load TEST manifest\n",
        "# -------------------------\n",
        "TEST_MANIFEST_PATH = f\"{WORK_DIR}/manifest_test_goal_vs_bg.csv\"  # adjust if needed\n",
        "df_test = pd.read_csv(TEST_MANIFEST_PATH).reset_index(drop=True)\n",
        "\n",
        "print(\"test rows:\", len(df_test))\n",
        "print(\"test label counts:\\n\", df_test[\"label\"].value_counts())\n",
        "\n",
        "# -------------------------\n",
        "# Labels (MUST match train)\n",
        "# -------------------------\n",
        "# IMPORTANT: reuse label2id from training\n",
        "# Example:\n",
        "# label2id = {\"background\": 0, \"goal\": 1}\n",
        "\n",
        "assert \"goal\" in label2id, \"label2id must come from training\"\n",
        "\n",
        "# -------------------------\n",
        "# Clip extraction\n",
        "# -------------------------\n",
        "def extract_clip_cv2(\n",
        "    video_path,\n",
        "    center_sec,\n",
        "    clip_sec=4.0,\n",
        "    num_frames=16,\n",
        "    size=112,\n",
        "):\n",
        "    cap = cv2.VideoCapture(video_path)\n",
        "    if not cap.isOpened():\n",
        "        raise RuntimeError(f\"Could not open video: {video_path}\")\n",
        "\n",
        "    fps = cap.get(cv2.CAP_PROP_FPS) or 25.0\n",
        "    start_sec = max(0.0, float(center_sec) - clip_sec / 2)\n",
        "    start_frame = int(start_sec * fps)\n",
        "\n",
        "    frames = []\n",
        "    step = int(max(1, (clip_sec * fps) / num_frames))\n",
        "\n",
        "    for i in range(num_frames):\n",
        "        cap.set(cv2.CAP_PROP_POS_FRAMES, start_frame + i * step)\n",
        "        ok, frame = cap.read()\n",
        "        if not ok:\n",
        "            break\n",
        "        frame = cv2.resize(frame, (size, size), interpolation=cv2.INTER_AREA)\n",
        "        frame = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)\n",
        "        frames.append(frame)\n",
        "\n",
        "    cap.release()\n",
        "\n",
        "    if len(frames) == 0:\n",
        "        raise RuntimeError(f\"No frames read from: {video_path}\")\n",
        "\n",
        "    while len(frames) < num_frames:\n",
        "        frames.append(frames[-1].copy())\n",
        "\n",
        "    arr = np.stack(frames, axis=0).astype(np.float32) / 255.0\n",
        "    arr = np.transpose(arr, (3, 0, 1, 2))  # (C,T,H,W)\n",
        "    return torch.from_numpy(arr)\n",
        "\n",
        "# -------------------------\n",
        "# Dataset (TEST)\n",
        "# -------------------------\n",
        "class SoccerNetTestClipDataset(Dataset):\n",
        "    def __init__(self, df, label2id, clip_sec=4.0, num_frames=16, size=112):\n",
        "        self.df = df.reset_index(drop=True)\n",
        "        self.label2id = label2id\n",
        "        self.clip_sec = clip_sec\n",
        "        self.num_frames = num_frames\n",
        "        self.size = size\n",
        "\n",
        "    def __len__(self):\n",
        "        return len(self.df)\n",
        "\n",
        "    def __getitem__(self, idx):\n",
        "        r = self.df.iloc[idx]\n",
        "        x = extract_clip_cv2(\n",
        "            r.video_path,\n",
        "            r.center_sec,\n",
        "            self.clip_sec,\n",
        "            self.num_frames,\n",
        "            self.size,\n",
        "        )\n",
        "\n",
        "        # labeled test\n",
        "        if r.label in self.label2id:\n",
        "            y = self.label2id[r.label]\n",
        "        else:\n",
        "            y = -1  # unlabeled test (inference-only)\n",
        "\n",
        "        return x, torch.tensor(y, dtype=torch.long)\n",
        "\n",
        "# -------------------------\n",
        "# DataLoader (TEST)\n",
        "# -------------------------\n",
        "test_ds = SoccerNetTestClipDataset(\n",
        "    df_test,\n",
        "    label2id,\n",
        "    clip_sec=4.0,\n",
        "    num_frames=16,\n",
        "    size=112,\n",
        ")\n",
        "\n",
        "test_loader = DataLoader(\n",
        "    test_ds,\n",
        "    batch_size=6,\n",
        "    shuffle=False,\n",
        "    num_workers=2,\n",
        "    pin_memory=True,\n",
        ")\n",
        "\n",
        "print(\"test loader ready\")\n",
        "\n"
      ]
    },
